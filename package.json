{
  "name": "prayerfly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:content": "node scripts/validate-content.ts",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
